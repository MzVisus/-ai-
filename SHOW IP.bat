@echo off
title 網路IP資訊查詢
color 0A
echo ======================================================================================
echo 正在取得本機網路資訊
echo ======================================================================================
echo.

::1、顯示內網 IPV4 位址
echo [內網IP資訊]
ipconfig|findstr /i "IPV4"
echo.

::2、顯示電腦名稱
echo [電腦名稱]
hostname
echo.




::3、顯示外網IP(使用curl呼叫API)
echo [外網IP]
curl -s https://api.ipify.org
if errorlevel 1 (
	::如果失敗，嘗試第二個來源
	curl -s https://icanhazip.com
)
echo.
echo.
echo ======================================================================================
echo 查詢完成！請按[任意鍵]關閉視窗
echo ======================================================================================
pause>nul
exit
